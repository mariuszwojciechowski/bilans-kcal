# Skopiuj do .env i uzupełnij (plik .env jest w .gitignore — NIGDY nie commituj sekretów)
# Moduł szacowania posiłków ze zdjęć — wystarczy JEDEN z kluczy:
# Gemini (Google AI Studio, darmowy tier): https://aistudio.google.com -> Get API key
GEMINI_API_KEY=AIza...
# albo Claude API (płatny, pay-as-you-go): https://platform.claude.com
# ANTHROPIC_API_KEY=sk-ant-...

# Wybór backendu: auto (domyślnie: gemini jeśli ma klucz, inaczej claude) | claude | gemini
# FIT_KRASNAL_LLM=auto

# Opcjonalnie: katalog na dane runtime (domyślnie ./data — poza repo)
# FIT_KRASNAL_DATA=/sciezka/do/danych

# Opcjonalnie: katalog tokenów sesji Garmina (domyślnie ~/.fit-krasnal/garth — poza repo)
# GARMINTOKENS=~/.fit-krasnal/garth
