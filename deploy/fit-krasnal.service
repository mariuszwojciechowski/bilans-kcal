[Unit]
Description=Fit Krasnal (FastAPI)
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=fitkrasnal
Group=fitkrasnal
WorkingDirectory=/opt/fit-krasnal

# Sekrety i konfiguracja poza repo (root:fitkrasnal, chmod 640).
EnvironmentFile=/etc/fit-krasnal/env

# Allowlista logowania z metadanych instancji GCE (jedno źródło prawdy w GCP).
# ExecStartPre pisze /run/fit-krasnal/env; drugi EnvironmentFile nadpisuje
# wartości z /etc. Poza GCE plik jest pusty i nic się nie zmienia.
RuntimeDirectory=fit-krasnal
RuntimeDirectoryMode=0750
ExecStartPre=/opt/fit-krasnal/deploy/fetch-metadata-env.sh /run/fit-krasnal/env
EnvironmentFile=-/run/fit-krasnal/env

# Nasłuch TYLKO na loopbacku — z internetu wejście wyłącznie przez Caddy (HTTPS).
ExecStart=/opt/fit-krasnal/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8321 --timeout-graceful-shutdown 10

# Deploy restarts used to hang until systemd's 90 s SIGKILL because open
# connections kept uvicorn from exiting.
TimeoutStopSec=20
Restart=always
RestartSec=3

# Ograniczenie uprawnień procesu.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/fit-krasnal
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
